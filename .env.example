# ─── Supabase ──────────────────────────────────────────────────────────────
# Projet hébergé en région eu-west-3 (Paris, RGPD).
# La waitlist insère via la CLÉ PUBLISHABLE (anon) + une policy RLS "INSERT only".
# NE JAMAIS utiliser la service-role key côté app.
#
# Si ces variables sont absentes, l'API /api/waitlist bascule en "mode démo"
# (log serveur, aucune écriture) et ne plante pas.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
